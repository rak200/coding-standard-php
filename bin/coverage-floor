#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Layer 2 (PHP) — the coverage floor, bound to the `coverage` verb.
 *
 *     bin/coverage-floor [clover-report] [floor-file]
 *
 * Enforced inside the CI job, from files in the repository, so the required check never
 * waits on a third party — Codecov is reporting only. The floor itself is per-repo state
 * in `.coverage-floor`, never a seed: it is hard-floored at 95 and ratchets up as
 * coverage improves.
 *
 * Deliberately a twin of the TypeScript binary rather than a shared one: both read the
 * same clover attributes, and a package that had to be installed by both ecosystems to
 * check a number would be worse than forty duplicated lines.
 *
 * This file holds $argv, stdio and the exit code, and nothing else. The logic it calls
 * lives in ../src/CoverageFloor.php so that it can be measured — see the note there.
 *
 * @author rak200 <rak.ricardo@windowslive.com>
 */

use Rak200\CodingStandardPhp\CoverageFloor;
use Rak200\CodingStandardPhp\FloorException;

// Two roots, because this binary runs in two places: from a checkout of this repository
// (its own vendor/) and from a consumer's vendor/bin (three levels up). Composer's own
// bin proxy resolves the second; the first exists so the standard can run on itself.
foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;

        break;
    }
}

$report = $argv[1] ?? 'coverage.xml';
$floorFile = $argv[2] ?? '.coverage-floor';

try {
    ['actual' => $actual, 'floor' => $floor, 'total' => $total, 'covered' => $covered, 'rose' => $rose]
        = CoverageFloor::evaluate($report, $floorFile);
} catch (FloorException $error) {
    fwrite(STDERR, "::error::coverage floor: {$error->getMessage()}\n");

    exit(1);
}

printf("coverage %.2f%% (%d/%d statements), floor %.2f%%\n", $actual, $covered, $total, $floor);

if ($rose) {
    printf("::notice::coverage rose to %.2f%% — raise %s to match\n", $actual, $floorFile);
}
