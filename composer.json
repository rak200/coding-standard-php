{
    "name": "rak200/coding-standard-php",
    "description": "Layer 2 of the rak200 baseline for PHP: the enforcing configuration and the prose that documents it",
    "type": "library",
    "license": "MIT",
    "keywords": ["standards", "static analysis", "code style", "mutation testing"],
    "authors": [
        {
            "name": "rak200",
            "email": "rak.ricardo@windowslive.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "friendsofphp/php-cs-fixer": "^3.68",
        "infection/infection": "^0.29",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
