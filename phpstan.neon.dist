# Layer 2 (PHP) — static analysis. Consumed by a repository as:
#
#   includes:
#       - vendor/rak200/coding-standard-php/phpstan.neon.dist
#
#   parameters:
#       paths:
#           - src
#           - tests
#
# `paths` is deliberately NOT set here. PHPStan resolves a relative path against the
# file that declares it, so a `paths: [src, tests]` in this file names directories
# inside the installed package — which do not exist, and the analyser refuses to start.
# Level and the analyser's own settings are the standard; what to look at is the
# consumer's business.
#
# A local phpstan.neon may override anything here and stays untracked.
#
# The three parameters beside `level` each carry their argument in CONVENTIONS.md,
# under "The three settings beside `level`". In short, and measured rather than
# reasoned:
#
#   treatPhpDocTypesAsCertain  PHP erases generics, so a guard over a class-string<T>
#                              or an iterable<K,V> is the only check there is, not a
#                              redundant one. PHPStan's default (true) reports it as
#                              redundant: four such errors across the estate, all the
#                              same identifier, none a bug.
#   reportUnmatchedIgnoredErrors  already the default; declared as a LOCK, because a
#                              suppression that has stopped applying is this estate's
#                              own `looks green, enforces nothing` shape.
#   reportIgnoresWithoutComments  NOT the default. The rule that a suppression must
#                              say why was written long before anything graded it.
#                              PHPStan reads the reason in exactly one form:
#                              `@phpstan-ignore <id> (reason)`, one line, once per
#                              identifier.
parameters:
    level: max
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    reportIgnoresWithoutComments: true

    # Where the code that travels lives: the directories whose classes and public
    # methods must carry a PHPDoc summary. Absolute, so a repository whose code is not
    # in src/ replaces the list — `documented!:` — rather than adding to it.
    rak200:
        documented:
            - %currentWorkingDirectory%/src

parametersSchema:
    rak200: structure([
        documented: listOf(string())
    ])

# Two rules of this package's own, because the conventions they enforce have no
# upstream rule to switch on.
#
# A callable is passed with first-class syntax, `trim(...)`, never as `'trim'` or
# `[$object, 'method']`. The editor marks `trimm(...)` as it is typed; `'trimm'` is
# text until the analyser runs. It reads types, so a name handed to `function_exists()`
# or `is_callable()`, or computed at run time, is not reported.
rules:
    - Rak200\CodingStandardPhp\PHPStan\FirstClassCallableRule

# Every class, interface, trait and enum, and every public method, under
# `rak200.documented` carries a PHPDoc summary: the documentation a package carries
# inside itself, and what a consumer's editor shows over a call. A doc comment that is
# only tags has no summary.
#
# Where a rule is genuinely wrong for one line, the suppression names its identifier:
# `// @phpstan-ignore rak200.firstClassCallable (the reason)`, or `rak200.docSummary`.
services:
    -
        class: Rak200\CodingStandardPhp\PHPStan\DocSummaryRule
        arguments:
            documented: %rak200.documented%
        tags:
            - phpstan.rules.rule
